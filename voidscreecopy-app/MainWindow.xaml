<Window x:Class="voidscreecopy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="voidscreecopy"
        Width="1200" Height="780"
        MinWidth="1000" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <SolidColorBrush x:Key="WindowBg" Color="#F5F7FA"/>
        <SolidColorBrush x:Key="SidebarBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="MainBg" Color="#F5F7FA"/>
        <SolidColorBrush x:Key="PanelBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CardHover" Color="#F0F4F8"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#1A2332"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#5A6B7F"/>
        <SolidColorBrush x:Key="TextMuted" Color="#8B9CB6"/>
        <SolidColorBrush x:Key="BorderLight" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="BorderMedium" Color="#CBD5E1"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#0077B6"/>
        <SolidColorBrush x:Key="AccentTeal" Color="#00B4D8"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#10B981"/>
        <SolidColorBrush x:Key="AccentOrange" Color="#F59E0B"/>
        <SolidColorBrush x:Key="AccentPurple" Color="#8B5CF6"/>
        <SolidColorBrush x:Key="AccentRed" Color="#E74C3C"/>
        <SolidColorBrush x:Key="SidebarActive" Color="#EBF5FF"/>
        <SolidColorBrush x:Key="SidebarHover" Color="#F0F4F8"/>
        <SolidColorBrush x:Key="TitleBarBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ButtonPrimary" Color="#0077B6"/>
        <SolidColorBrush x:Key="ButtonSecondary" Color="#E8EDF2"/>
        <SolidColorBrush x:Key="LogBg" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="IconBgBlue" Color="#EBF5FF"/>
        <SolidColorBrush x:Key="IconBgOrange" Color="#FFF3E6"/>
        <SolidColorBrush x:Key="IconBgPurple" Color="#F3EEFF"/>
        <SolidColorBrush x:Key="IconBgNeutral" Color="#F0F4F8"/>
        <SolidColorBrush x:Key="IconBgGreen" Color="#E8F5E9"/>
        <SolidColorBrush x:Key="StatusGreenBg" Color="#F0FDF4"/>
        <SolidColorBrush x:Key="StatusGreenText" Color="#166534"/>
        <SolidColorBrush x:Key="UpdateBannerBg" Color="#EBF8FF"/>
        <SolidColorBrush x:Key="UpdateBannerBorder" Color="#B3E5FC"/>
        <SolidColorBrush x:Key="UpdateBannerIconBg" Color="#DBEAFE"/>
        <SolidColorBrush x:Key="ProgressBarBg" Color="#E0E0E0"/>
        <SolidColorBrush x:Key="WindowButtonHover" Color="#E8EDF2"/>
        <SolidColorBrush x:Key="SecondaryBtnHover" Color="#D5DDE6"/>
        <SolidColorBrush x:Key="SecondaryBtnPressed" Color="#C2CCD6"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style TargetType="Button" x:Key="SidebarButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" 
                                Padding="{TemplateBinding Padding}" 
                                CornerRadius="10" Margin="8,2">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SidebarHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="WindowButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource WindowButtonHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="PrimaryButton">
            <Setter Property="Background" Value="{DynamicResource ButtonPrimary}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="28,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="46"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" 
                                Padding="{TemplateBinding Padding}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#005F8A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#004D73"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="SecondaryButton">
            <Setter Property="Background" Value="{DynamicResource ButtonSecondary}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" 
                                Padding="{TemplateBinding Padding}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SecondaryBtnHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SecondaryBtnPressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Border" x:Key="Card">
            <Setter Property="Background" Value="{DynamicResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="22"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="12" Opacity="0.06" ShadowDepth="2" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource LogBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLight}"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Margin" Value="0,4,0,10"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource LogBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource LogBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
        </Style>

    </Window.Resources>

    <Border Background="{DynamicResource WindowBg}" CornerRadius="12" BorderBrush="{DynamicResource BorderLight}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" Opacity="0.15" ShadowDepth="4" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" Background="{DynamicResource TitleBarBg}" CornerRadius="12,12,0,0" 
                    BorderBrush="{DynamicResource BorderLight}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- App Logo + Name -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="30" Height="30" CornerRadius="8" Padding="3" Margin="0,0,10,0">
                            <Border.Background>
                                <ImageBrush ImageSource="Assets/voidscreecopy-logo.png" Stretch="Uniform"/>
                            </Border.Background>
                        </Border>
                        <TextBlock Text="voidscreecopy" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock x:Name="VersionText" Text=" v3.3.1" FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>

                    <!-- Connection Status -->
                    <Border Grid.Column="1" Background="{DynamicResource StatusGreenBg}" CornerRadius="14" Padding="14,5" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource AccentGreen}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ConnectionStatusText" Text="No devices connected" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource StatusGreenText}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Window Controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="MinimizeButton" Style="{StaticResource WindowButton}" Content="&#xE949;" FontFamily="Segoe MDL2 Assets" Click="MinimizeButton_Click"/>
                        <Button x:Name="MaximizeButton" Style="{StaticResource WindowButton}" Content="&#xE922;" FontFamily="Segoe MDL2 Assets" Click="MaximizeButton_Click" Margin="2,0"/>
                        <Button x:Name="CloseButton" Style="{StaticResource WindowButton}" Content="&#xE106;" FontFamily="Segoe MDL2 Assets" Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="280"/>
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border Grid.Column="0" Background="{DynamicResource SidebarBg}" 
                        BorderBrush="{DynamicResource BorderLight}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="1" Margin="8,0">
                            <!-- Screen Tab -->
                            <Button x:Name="NavScreen" Style="{StaticResource SidebarButton}" Click="NavScreen_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="NavScreenIndicator" Grid.Column="0" Background="{DynamicResource AccentBlue}" CornerRadius="2" Margin="0,4,8,4" Width="3" HorizontalAlignment="Left" Visibility="Visible"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource IconBgBlue}" Margin="0,0,12,0">
                                            <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource AccentBlue}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Screen" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- Camera Tab -->
                            <Button x:Name="NavCamera" Style="{StaticResource SidebarButton}" Click="NavCamera_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="NavCameraIndicator" Grid.Column="0" Background="{DynamicResource AccentOrange}" CornerRadius="2" Margin="0,4,8,4" Width="3" HorizontalAlignment="Left" Visibility="Collapsed"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource IconBgOrange}" Margin="0,0,12,0">
                                            <TextBlock Text="&#xE722;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource AccentOrange}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Camera" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- TV Tab -->
                            <Button x:Name="NavTv" Style="{StaticResource SidebarButton}" Click="NavTv_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="NavTvIndicator" Grid.Column="0" Background="{DynamicResource AccentPurple}" CornerRadius="2" Margin="0,4,8,4" Width="3" HorizontalAlignment="Left" Visibility="Collapsed"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource IconBgPurple}" Margin="0,0,12,0">
                                            <TextBlock Text="&#xE7F0;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource AccentPurple}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="TV" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- Settings Tab -->
                            <Button x:Name="NavSettings" Style="{StaticResource SidebarButton}" Click="NavSettings_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="NavSettingsIndicator" Grid.Column="0" Background="{DynamicResource TextMuted}" CornerRadius="2" Margin="0,4,8,4" Width="3" HorizontalAlignment="Left" Visibility="Collapsed"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource IconBgNeutral}" Margin="0,0,12,0">
                                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Settings" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- Admin Tab (admin only) -->
                            <Button x:Name="NavAdmin" Style="{StaticResource SidebarButton}" Click="NavAdmin_Click" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="NavAdminIndicator" Grid.Column="0" Background="{DynamicResource AccentPurple}" CornerRadius="2" Margin="0,4,8,4" Width="3" HorizontalAlignment="Left" Visibility="Collapsed"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource IconBgPurple}" Margin="0,0,12,0">
                                            <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource AccentPurple}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Admin" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </StackPanel>

                        <!-- Sidebar Bottom -->
                        <StackPanel Grid.Row="2" Margin="16,0,16,16">
                            <Button x:Name="StopAllSidebar" Style="{StaticResource SecondaryButton}" 
                                    Click="StopAllButton_Click" HorizontalAlignment="Stretch" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE71A;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Stop All" FontSize="13"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Main Content Area -->
                <Grid Grid.Column="1" Background="{DynamicResource MainBg}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Content Header -->
                    <Border Grid.Row="0" Padding="26,18,26,14">
                        <StackPanel>
                            <TextBlock x:Name="PageTitle" Text="Screen Mirroring" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock x:Name="PageSubtitle" Text="Share your Android device screen to OBS" Foreground="{DynamicResource TextMuted}" FontSize="13" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Page Content (switches based on tab) -->
                    <Grid Grid.Row="1" Margin="24,0,24,16">
                        <Grid x:Name="ScreenPage" Visibility="Visible">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Device Selection -->
                            <Border Grid.Row="0" Style="{StaticResource Card}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource IconBgBlue}" Margin="0,0,10,0">
                                            <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource AccentBlue}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Device Setup" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Screen Device" FontSize="12" FontWeight="Medium" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                                            <ComboBox x:Name="ScreenDeviceCombo" DisplayMemberPath="DisplayName" FontSize="13"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Camera Device" FontSize="12" FontWeight="Medium" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                                            <ComboBox x:Name="CameraDeviceCombo" DisplayMemberPath="DisplayName" FontSize="13"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Screen Quality" FontSize="12" FontWeight="Medium" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                                            <ComboBox x:Name="ScreenQualityCombo" FontSize="13"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Camera Quality" FontSize="12" FontWeight="Medium" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                                            <ComboBox x:Name="CameraQualityCombo" SelectionChanged="CameraQualityCombo_SelectionChanged" FontSize="13"/>
                                        </StackPanel>
                                    </Grid>
                                    <Border x:Name="QualityWarning" Background="{DynamicResource IconBgOrange}" CornerRadius="6" Padding="10,8" Margin="0,8,0,0" Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource AccentOrange}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="QualityWarningText" Foreground="{DynamicResource AccentOrange}" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Connected Devices List -->
                            <Border Grid.Row="1" Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource IconBgNeutral}" Margin="0,0,10,0">
                                                <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="Connected Devices" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Button x:Name="RefreshButton" Content="Refresh" Style="{StaticResource SecondaryButton}" 
                                                Click="RefreshButton_Click" HorizontalAlignment="Right" Padding="14,6" MinHeight="32"/>
                                    </Grid>
                                    <Border Background="{DynamicResource LogBg}" CornerRadius="10" BorderBrush="{DynamicResource BorderLight}" BorderThickness="1" MinHeight="120">
                                        <ListBox x:Name="DeviceList" DisplayMemberPath="DisplayName" Background="Transparent" BorderThickness="0"/>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <TextBlock Text="&#xE783;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Both devices must show status 'device'. Unauthorized? Tap Allow on your phone." 
                                                   Foreground="{DynamicResource TextMuted}" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Start Button -->
                            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="22">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="StartButton" Grid.Column="0" Content="Start OBS Share" 
                                            Style="{StaticResource PrimaryButton}" Click="StartButton_Click" FontSize="15"/>
                                    <Button x:Name="CameraSizesButton" Grid.Column="2" Content="Camera Sizes" 
                                            Style="{StaticResource SecondaryButton}" Click="CameraSizesButton_Click"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Camera Page -->
                        <Grid x:Name="CameraPage" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Style="{StaticResource Card}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource IconBgOrange}" Margin="0,0,10,0">
                                            <TextBlock Text="&#xE722;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource AccentOrange}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Camera Settings" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="Camera Device" FontSize="12" FontWeight="Medium" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="CameraDeviceCombo2" DisplayMemberPath="DisplayName" FontSize="13"/>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Camera Quality" FontSize="12" FontWeight="Medium" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                                            <ComboBox x:Name="CameraQualityCombo2" SelectionChanged="CameraQualityCombo_SelectionChanged" FontSize="13"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Camera Facing" FontSize="12" FontWeight="Medium" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                                            <ComboBox x:Name="CameraFacingCombo" FontSize="13"/>
                                        </StackPanel>
                                    </Grid>
                                    <Border Background="{DynamicResource IconBgNeutral}" CornerRadius="6" Padding="10,8" Margin="0,10,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE783;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="CameraInfoText" Text="Camera mirroring requires Android 12+ on the device." 
                                                       Foreground="{DynamicResource TextMuted}" FontSize="12" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource IconBgNeutral}" Margin="0,0,10,0">
                                                <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="Connected Devices" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                    <Border Background="{DynamicResource LogBg}" CornerRadius="10" BorderBrush="{DynamicResource BorderLight}" BorderThickness="1" MinHeight="100">
                                        <ListBox x:Name="DeviceList2" DisplayMemberPath="DisplayName" Background="Transparent" BorderThickness="0"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="22">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="StartCameraButton" Grid.Column="0" Content="Start Camera Share" 
                                            Style="{StaticResource PrimaryButton}" Click="StartCameraButton_Click" FontSize="15"/>
                                    <Button x:Name="CameraSizesButton2" Grid.Column="2" Content="Camera Sizes" 
                                            Style="{StaticResource SecondaryButton}" Click="CameraSizesButton_Click"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- TV Page -->
                        <Grid x:Name="TvPage" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource IconBgPurple}" Margin="0,0,10,0">
                                                <TextBlock Text="&#xE7F0;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource AccentPurple}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="Wi-Fi TV Connection" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Button x:Name="ScanTvButton" Content="Scan Wi-Fi TVs" Style="{StaticResource SecondaryButton}" 
                                                Click="ScanTvButton_Click" HorizontalAlignment="Right" Padding="14,6" MinHeight="32"/>
                                    </Grid>
                                    <TextBlock x:Name="TvHelpText" Text="Scan for Android TV devices on your Wi-Fi network. Enable Developer Options and Network/Wireless Debugging on your TV." 
                                               Foreground="{DynamicResource TextMuted}" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Found TVs" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                    <Border Background="{DynamicResource LogBg}" CornerRadius="10" BorderBrush="{DynamicResource BorderLight}" BorderThickness="1" MinHeight="120">
                                        <ListBox x:Name="TvList" DisplayMemberPath="DisplayName" Background="Transparent" BorderThickness="0"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="2" Style="{StaticResource Card}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource IconBgGreen}" Margin="0,0,10,0">
                                            <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource AccentGreen}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Chromecast (No ADB needed)" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="Use Chrome browser to cast your PC screen to the TV. No Developer Options required." 
                                               Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,0,0,12" TextWrapping="Wrap"/>
                                    <Button x:Name="OpenCastButton" Content="Open Chrome Cast" Style="{StaticResource SecondaryButton}" 
                                            Click="OpenCastButton_Click" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="3" Style="{StaticResource Card}" Padding="22">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="ConnectTvButton" Grid.Column="0" Content="Connect to Selected TV" 
                                            Style="{StaticResource PrimaryButton}" Click="ConnectTvButton_Click" FontSize="15"/>
                                    <Button x:Name="FixAdbButton" Grid.Column="2" Content="Fix ADB" 
                                            Style="{StaticResource SecondaryButton}" Click="FixAdbButton_Click"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Settings Page -->
                        <Grid x:Name="SettingsPage" Visibility="Collapsed">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                                <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource IconBgNeutral}" Margin="0,0,10,0">
                                                    <TextBlock Text="&#xE793;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="Appearance" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Theme" FontSize="12" FontWeight="Medium" Foreground="{StaticResource TextSecondary}"/>
                                                    <TextBlock Text="Switch between light and dark mode" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <Button x:Name="ThemeToggleButton" Grid.Column="1" Style="{StaticResource SecondaryButton}" 
                                                        Click="ThemeToggleButton_Click" Padding="16,8" MinWidth="100">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock x:Name="ThemeIcon" Text="&#xE706;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                        <TextBlock x:Name="ThemeLabel" Text="Dark" FontSize="13" FontWeight="Medium" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                                <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource IconBgNeutral}" Margin="0,0,10,0">
                                                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="Application" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Current Version" FontSize="12" FontWeight="Medium" Foreground="{StaticResource TextSecondary}"/>
                                                    <TextBlock x:Name="SettingsVersionText" Text="3.3.6" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,4,0,0"/>
                                                </StackPanel>
                                                <Border Grid.Column="1" Background="{DynamicResource StatusGreenBg}" CornerRadius="8" Padding="12,6" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource AccentGreen}" Margin="0,0,8,0"/>
                                                        <TextBlock Text="Up to date" Foreground="{DynamicResource StatusGreenText}" FontSize="12" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                                <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource IconBgBlue}" Margin="0,0,10,0">
                                                    <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource AccentBlue}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="Auto-Update" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="When the app starts, it checks for new versions from the configured update server." 
                                                       Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,0,0,14" TextWrapping="Wrap"/>
                                            <TextBlock Text="Update Manifest URL" FontSize="12" FontWeight="Medium" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                                            <TextBox x:Name="ManifestUrlBox" IsReadOnly="True" FontSize="11"/>
                                            <Grid Margin="0,14,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Button x:Name="CheckUpdateButton" Grid.Column="0" Content="Check for Updates" 
                                                        Style="{StaticResource SecondaryButton}" Click="CheckUpdateButton_Click" HorizontalAlignment="Left"/>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource AccentGreen}" Margin="0,0,8,0"/>
                                                    <TextBlock x:Name="UpdateStatusText" Text="Up to date" FontSize="12" FontWeight="Medium" Foreground="{StaticResource TextSecondary}"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Update Banner -->
                                    <Border x:Name="UpdateBanner" Style="{StaticResource Card}" Background="{DynamicResource UpdateBannerBg}" BorderBrush="{DynamicResource UpdateBannerBorder}" Visibility="Collapsed">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource UpdateBannerIconBg}" Margin="0,0,10,0">
                                                    <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource AccentBlue}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock x:Name="UpdateTitleText" Text="Update Available" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentBlue}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock x:Name="UpdateNotesText" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,12" TextWrapping="Wrap"/>
                                            <ProgressBar x:Name="UpdateProgressBar" Height="6" Minimum="0" Maximum="100" Background="{DynamicResource ProgressBarBg}" Foreground="{DynamicResource AccentBlue}" Visibility="Collapsed" Margin="0,0,0,8"/>
                                            <TextBlock x:Name="UpdateProgressText" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="0,0,0,10" Visibility="Collapsed"/>
                                            <WrapPanel>
                                                <Button x:Name="UpdateNowButton" Content="Update Now" Style="{StaticResource PrimaryButton}" 
                                                        Click="UpdateNowButton_Click" Margin="0,0,8,0" Padding="20,8"/>
                                                <Button x:Name="RemindLaterButton" Content="Remind Later" Style="{StaticResource SecondaryButton}" 
                                                        Click="RemindLaterButton_Click" Margin="0,0,8,0" Padding="16,8"/>
                                                <Button x:Name="SkipVersionButton" Content="Skip Version" Style="{StaticResource SecondaryButton}" 
                                                        Click="SkipVersionButton_Click" Padding="16,8"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                                <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource IconBgNeutral}" Margin="0,0,10,0">
                                                    <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="About" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="voidscreecopy is a low-latency Android screen, camera, and TV sharing controller for OBS." 
                                                       Foreground="{StaticResource TextSecondary}" FontSize="13" TextWrapping="Wrap" LineHeight="20"/>
                                            <TextBlock Text="Uses scrcpy 3.3.4 for device mirroring. Supports USB and Wi-Fi connections." 
                                                       Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- Right Panel -->
                <Border Grid.Column="2" Background="{DynamicResource PanelBg}" 
                        BorderBrush="{DynamicResource BorderLight}" BorderThickness="1,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,16,0,0">
                                <!-- OBS Windows Info -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                            <Border Width="28" Height="28" CornerRadius="6" Background="{DynamicResource IconBgBlue}" Margin="0,0,10,0">
                                                <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource AccentBlue}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="OBS Window Capture" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="Add Window Capture in OBS and select:" Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,0,0,12"/>
                                        <Border Background="{DynamicResource IconBgBlue}" CornerRadius="8" Padding="14,11" Margin="0,0,0,8">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource AccentBlue}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="OBS_TAB_SCREEN" FontFamily="Consolas" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentBlue}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{DynamicResource IconBgOrange}" CornerRadius="8" Padding="14,11">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource AccentOrange}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="OBS_MOBILE_CAMERA" FontFamily="Consolas" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentOrange}"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Status Log -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <Border Width="28" Height="28" CornerRadius="6" Background="{DynamicResource IconBgNeutral}" Margin="0,0,10,0">
                                                <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="Activity Log" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Border Background="{DynamicResource LogBg}" CornerRadius="8" BorderBrush="{DynamicResource BorderLight}" BorderThickness="1">
                                            <TextBox x:Name="LogBox" MinHeight="180" MaxHeight="350" IsReadOnly="True" 
                                                     AcceptsReturn="True" VerticalScrollBarVisibility="Auto" 
                                                     Background="Transparent" BorderThickness="0" Padding="12,10"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Bottom Status -->
                        <Border Grid.Row="1" Padding="20,14" BorderBrush="{DynamicResource BorderLight}" BorderThickness="0,1,0,0">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource AccentGreen}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="BottomStatusText" Text="Ready" FontSize="12" FontWeight="Medium" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- AUTH OVERLAY: Login Page -->
            <Grid x:Name="LoginPage" Grid.RowSpan="2" Visibility="Visible" Background="{DynamicResource WindowBg}">
                <Border Background="{DynamicResource WindowBg}" Opacity="0.92"/>
                <Border Background="{DynamicResource CardBg}" CornerRadius="14" BorderBrush="{DynamicResource BorderLight}" BorderThickness="1"
                        Width="400" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="36,32">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" Opacity="0.12" ShadowDepth="4" Color="#000000"/>
                    </Border.Effect>
                    <StackPanel HorizontalAlignment="Center">
                        <!-- App Logo -->
                        <Border Width="60" Height="60" CornerRadius="16" HorizontalAlignment="Center" Margin="0,0,0,18">
                            <Border.Background>
                                <ImageBrush ImageSource="Assets/voidscreecopy-logo.png" Stretch="Uniform"/>
                            </Border.Background>
                        </Border>
                        <!-- Title -->
                        <TextBlock x:Name="LoginTitle" Text="Welcome back" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="LoginSubtitle" Text="Sign in to use voidscreecopy" FontSize="13" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" Margin="0,4,0,22"/>

                        <!-- Login Form -->
                        <StackPanel x:Name="LoginForm">
                            <!-- Email -->
                            <TextBlock Text="Email" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6"/>
                            <TextBox x:Name="LoginEmail" FontSize="13" Padding="12,10" Margin="0,0,0,14" FontFamily="Segoe UI"/>

                            <!-- Password -->
                            <TextBlock Text="Password" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6"/>
                            <PasswordBox x:Name="LoginPassword" FontSize="13" Padding="12,10" Margin="0,0,0,6"/>

                            <!-- Error -->
                            <TextBlock x:Name="LoginError" Foreground="{DynamicResource AccentRed}" FontSize="12" FontWeight="Medium"
                                       TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed" HorizontalAlignment="Center" TextAlignment="Center"/>

                            <!-- Login Button -->
                            <Button x:Name="LoginButton" Content="Sign In" Style="{StaticResource PrimaryButton}"
                                    Click="LoginButton_Click" HorizontalAlignment="Stretch" Margin="0,16,0,0" MinHeight="46" FontSize="15"/>

                            <!-- Loading indicator -->
                            <StackPanel x:Name="LoginLoading" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0" Visibility="Collapsed">
                                <Border Width="18" Height="18" CornerRadius="9" BorderThickness="2" BorderBrush="{DynamicResource AccentBlue}" Margin="0,0,10,0">
                                    <Border.RenderTransform>
                                        <RotateTransform x:Name="LoginSpinner" Angle="0"/>
                                    </Border.RenderTransform>
                                </Border>
                                <TextBlock Text="Signing in..." FontSize="12" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Create Account Link -->
                            <TextBlock FontSize="12" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" Margin="0,16,0,0">
                                <Run Text="Don't have an account?"/>
                            </TextBlock>
                            <Button Style="{StaticResource SecondaryButton}" Click="ShowCreateAccount_Click"
                                    HorizontalAlignment="Center" Padding="20,8" Margin="0,6,0,0">
                                <TextBlock Text="Create Account" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBlue}"/>
                            </Button>
                        </StackPanel>

                        <!-- Create Account Form (hidden by default) -->
                        <StackPanel x:Name="CreateAccountForm" Visibility="Collapsed">
                            <!-- Name -->
                            <TextBlock Text="Full Name" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6"/>
                            <TextBox x:Name="RegisterNameBox" FontSize="13" Padding="12,10" Margin="0,0,0,14" FontFamily="Segoe UI"/>

                            <!-- Email -->
                            <TextBlock Text="Email" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6"/>
                            <TextBox x:Name="RegisterEmail" FontSize="13" Padding="12,10" Margin="0,0,0,14" FontFamily="Segoe UI"/>

                            <!-- Password -->
                            <TextBlock Text="Password" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6"/>
                            <PasswordBox x:Name="RegisterPassword" FontSize="13" Padding="12,10" Margin="0,0,0,14"/>

                            <!-- Error -->
                            <TextBlock x:Name="RegisterError" Foreground="{DynamicResource AccentRed}" FontSize="12" FontWeight="Medium"
                                       TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed" HorizontalAlignment="Center" TextAlignment="Center"/>

                            <!-- Success -->
                            <TextBlock x:Name="RegisterSuccess" Foreground="{DynamicResource AccentGreen}" FontSize="12" FontWeight="Medium"
                                       TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed" HorizontalAlignment="Center" TextAlignment="Center"/>

                            <!-- Register Button -->
                            <Button x:Name="RegisterButton" Content="Create Account" Style="{StaticResource PrimaryButton}"
                                    Click="CreateAccount_Click" HorizontalAlignment="Stretch" Margin="0,16,0,0" MinHeight="46" FontSize="15"/>

                            <!-- Loading indicator -->
                            <StackPanel x:Name="RegisterLoading" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0" Visibility="Collapsed">
                                <Border Width="18" Height="18" CornerRadius="9" BorderThickness="2" BorderBrush="{DynamicResource AccentBlue}" Margin="0,0,10,0">
                                    <Border.RenderTransform>
                                        <RotateTransform Angle="0"/>
                                    </Border.RenderTransform>
                                </Border>
                                <TextBlock Text="Creating account..." FontSize="12" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Back to Login Link -->
                            <TextBlock FontSize="12" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" Margin="0,16,0,0">
                                <Run Text="Already have an account?"/>
                            </TextBlock>
                            <Button Style="{StaticResource SecondaryButton}" Click="ShowLogin_Click"
                                    HorizontalAlignment="Center" Padding="20,8" Margin="0,6,0,0">
                                <TextBlock Text="Sign In" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBlue}"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- AUTH OVERLAY: Access Denied Page -->
            <Grid x:Name="AccessDeniedPage" Grid.RowSpan="2" Visibility="Collapsed" Background="{DynamicResource WindowBg}">
                <Border Background="{DynamicResource WindowBg}" Opacity="0.92"/>
                <Border Background="{DynamicResource CardBg}" CornerRadius="14" BorderBrush="{DynamicResource BorderLight}" BorderThickness="1"
                        Width="460" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="36,32">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" Opacity="0.12" ShadowDepth="4" Color="#000000"/>
                    </Border.Effect>
                    <StackPanel HorizontalAlignment="Center">
                        <!-- Warning Icon -->
                        <Border Width="80" Height="80" CornerRadius="40" Background="#FEE2E2" HorizontalAlignment="Center" Margin="0,0,0,20">
                            <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="32" Foreground="#DC2626"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <!-- Title -->
                        <TextBlock Text="Access Denied" FontSize="22" FontWeight="Bold" Foreground="#DC2626" HorizontalAlignment="Center"/>
                        <TextBlock Text="You do not have permission to use this application" FontSize="13" Foreground="{DynamicResource TextMuted}"
                                   HorizontalAlignment="Center" Margin="0,6,0,20" TextAlignment="Center" TextWrapping="Wrap"/>

                        <!-- Reason Box -->
                        <Border x:Name="DeniedReasonBorder" Background="#FEF2F2" CornerRadius="8" Padding="14,12" Margin="0,0,0,18"
                                BorderBrush="#FECACA" BorderThickness="1">
                            <TextBlock x:Name="DeniedReasonText" Text="Reason not specified." FontSize="12" Foreground="#991B1B"
                                       TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>
                        </Border>

                        <!-- Contact -->
                        <TextBlock Text="Contact the administrator for access." FontSize="12" Foreground="{DynamicResource TextMuted}"
                                   HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,18">
                            <Run Text="Email: " Foreground="{DynamicResource TextMuted}"/>
                            <Run Text="voidhunterx@gmail.com" Foreground="{DynamicResource AccentBlue}" FontWeight="SemiBold"/>
                        </TextBlock>

                        <!-- Back Button -->
                        <Button Content="Back to Sign In" Style="{StaticResource SecondaryButton}"
                                Click="BackToLogin_Click" HorizontalAlignment="Center" Padding="28,10"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- AUTH OVERLAY: Admin Page -->
            <Grid x:Name="AdminPage" Grid.RowSpan="2" Visibility="Collapsed" Background="{DynamicResource WindowBg}">
                <Border Background="{DynamicResource WindowBg}" Opacity="0.96"/>
                <Grid Margin="40,30">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" Style="{StaticResource Card}" Padding="22,16" Margin="0,0,0,14">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource IconBgBlue}" Margin="0,0,12,0">
                                    <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource AccentBlue}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="User Management" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimary}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Style="{StaticResource PrimaryButton}" Click="AdminGoToApp_Click"
                                        Padding="18,8" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Go to App" FontSize="13" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SecondaryButton}" Click="AdminSignOut_Click"
                                        Padding="18,8" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Sign Out" FontSize="13" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Content -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="280"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: User List -->
                        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="18,16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Registered Users" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,12"/>
                                <Border Grid.Row="1" Background="{DynamicResource LogBg}" CornerRadius="10"
                                        BorderBrush="{DynamicResource BorderLight}" BorderThickness="1">
                                    <ListBox x:Name="AdminUserList" Background="Transparent" BorderThickness="0"
                                             SelectionChanged="AdminUserList_SelectionChanged" Padding="4">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="4,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="10" Height="10" CornerRadius="5"
                                                            Margin="0,0,10,0" VerticalAlignment="Center">
                                                        <Border.Background>
                                                            <SolidColorBrush Color="{Binding StatusColor}"/>
                                                        </Border.Background>
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{Binding Email}" FontSize="13"
                                                               Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding StatusText}" FontSize="11"
                                                               Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Right: Add/Edit Form -->
                        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18,16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock x:Name="AdminFormTitle" Grid.Row="0" Text="Add User" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,14"/>

                                <!-- Email -->
                                <TextBlock Grid.Row="1" Text="Email" FontSize="12" FontWeight="Medium"
                                           Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                                <TextBox x:Name="AdminNewEmail" Grid.Row="2" FontSize="12" Padding="10,8" Margin="0,0,0,12"/>

                                <!-- Password -->
                                <TextBlock Grid.Row="3" Text="Password" FontSize="12" FontWeight="Medium"
                                           Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                                <TextBox x:Name="AdminNewPassword" Grid.Row="4" FontSize="12" Padding="10,8" Margin="0,0,0,12"/>

                                <!-- Status Toggle -->
                                <TextBlock Grid.Row="5" Text="Status" FontSize="12" FontWeight="Medium"
                                           Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                                <Grid Grid.Row="6" Margin="0,0,0,12">
                                    <Button x:Name="AdminToggleStatus" Click="AdminToggleStatus_Click"
                                            Style="{StaticResource SecondaryButton}" Padding="12,6" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <Border x:Name="AdminStatusDot" Width="10" Height="10" CornerRadius="5"
                                                    Background="{DynamicResource AccentGreen}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="AdminStatusToggleText" Text="Enabled" FontSize="12" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Denied Reason -->
                                <TextBlock Grid.Row="7" Text="Denied Reason (if disabled)" FontSize="12" FontWeight="Medium"
                                           Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                                <TextBox x:Name="AdminDeniedReason" Grid.Row="8" FontSize="12" Padding="10,8" Margin="0,0,0,12"
                                         AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="80"/>

                                <!-- Buttons -->
                                <StackPanel x:Name="AdminAddButtons" Grid.Row="9" Margin="0,0,0,12">
                                    <Button x:Name="AdminAddUserBtn" Content="Add User" Style="{StaticResource PrimaryButton}"
                                            Click="AdminAddUser_Click" HorizontalAlignment="Stretch" Margin="0,0,0,8" MinHeight="38" FontSize="13"/>
                                    <Button x:Name="AdminSaveBtn" Style="{StaticResource SecondaryButton}"
                                            Click="AdminSave_Click" HorizontalAlignment="Stretch" MinHeight="38" FontSize="13">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Save to GitHub" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <StackPanel x:Name="AdminEditButtons" Grid.Row="9" Margin="0,0,0,12" Visibility="Collapsed">
                                    <Button x:Name="AdminUpdateUserBtn" Content="Update User" Style="{StaticResource PrimaryButton}"
                                            Click="AdminUpdateUser_Click" HorizontalAlignment="Stretch" Margin="0,0,0,8" MinHeight="38" FontSize="13"/>
                                    <Button x:Name="AdminCancelEditBtn" Content="Cancel" Style="{StaticResource SecondaryButton}"
                                            Click="AdminCancelEdit_Click" HorizontalAlignment="Stretch" MinHeight="38" FontSize="13"/>
                                </StackPanel>

                                <!-- Status -->
                                <TextBlock x:Name="AdminStatusText" Grid.Row="10" Text="" FontSize="11"
                                           Foreground="{DynamicResource AccentGreen}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                <!-- GitHub Token Section -->
                                <Border Grid.Row="11" Background="{DynamicResource LogBg}" CornerRadius="8"
                                        BorderBrush="{DynamicResource BorderLight}" BorderThickness="1" Padding="12,10" Margin="0,4,0,0">
                                    <StackPanel>
                                        <TextBlock Text="GitHub Personal Access Token (for saving)" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6"/>
                                        <TextBox x:Name="AdminGithubToken" FontSize="11" Padding="8,6" FontFamily="Consolas"
                                                 Text="" Margin="0,0,0,6"/>
                                        <TextBlock FontSize="10" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap">
                                            A PAT with repo scope is required to save users.json. Create one at
                                            <Run Text="github.com/settings/tokens" Foreground="{DynamicResource AccentBlue}"/>
                                            with full "repo" permission.
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

        </Grid>
    </Border>
</Window>